{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blog/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "types": ["vitest/globals"],
    "paths": {
      "@web/*": ["./src/*"],
      "@blog/ui/*": ["../../packages/ui/src/*"],
      "@blog/service/*": ["../../packages/service/src/*"],
      "@blog/db/*": ["../../packages/db/src/*"],
      "@blog/insight/*": ["../../packages/insight/src/*"],
      "@blog/auth/*": ["../../packages/auth/src/*"],
      "@blog/config/*": ["../../packages/config/src/*"],
      "@blog/utils/*": ["../../packages/utils/src/*"],
      "@blog/email/*": ["../../packages/email/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "index.css.d.ts",
    // TS only loads global ambient .d.ts files via a program's own include,
    // never transitively through import resolution — so any dependency's
    // ambient declarations (e.g. @blog/ui's `*.svg`/`*.svg?url` types in
    // src/assets/icons/svg.d.ts, @blog/auth's next-auth module augmentation)
    // must be listed here explicitly.
    "../../packages/ui/src/**/*.d.ts",
    "../../packages/auth/src/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
