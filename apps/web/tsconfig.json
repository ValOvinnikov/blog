{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blog/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "types": ["vitest/globals"],
    "paths": {
      "@web/*": ["./src/*"],
      "@blog/ui/*": ["../../packages/ui/src/*"],
      "@blog/service/*": ["../../packages/service/src/*"],
      "@blog/db/*": ["../../packages/db/src/*"],
      "@blog/config/*": ["../../packages/config/src/*"],
      "@blog/utils/*": ["../../packages/utils/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "index.css.d.ts",
    // @blog/ui's wildcard subpath export ("./*": "./src/*", aliased below)
    // means web's program type-checks @blog/ui *source* directly, so its
    // ambient module declarations (e.g. the `*.svg`/`*.svg?url` types in
    // src/assets/icons/svg.d.ts) must be in this program too — TS only
    // loads global ambient .d.ts files via a program's own include, never
    // transitively through import resolution.
    "../../packages/ui/src/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
