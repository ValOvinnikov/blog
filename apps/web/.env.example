NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SITE_URL=
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
SITE_CONFIG_REVALIDATE_SECRET=
SANITY_GENERATE_SECRET=
ANTHROPIC_API_KEY=
WEB_ANALYTICS_ENABLED=

DATABASE_URL=

# The six vars below are read by @blog/auth (packages/auth/src/utils/env/env.ts),
# not declared in this app's own src/utils/env/env.ts — each app runs its own
# Node process and @blog/auth reads whichever process loaded it, so they still
# have to be set here. Do not delete them just because a grep of apps/web
# turns up no declaration.
# AUTH_SECRET signs/encrypts Auth.js cookies. Each app keeps its own sessions;
# matching apps/platform's value is an operational choice, not a requirement
# (see docs/context/environment-variables.md).
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
MAGIC_LINK_FROM_ADDRESS=

# RESEND_API_KEY is read by @blog/email (packages/email/src/utils/env/env.ts),
# the only place in the repo that sends mail, not declared in this app's own
# src/utils/env/env.ts — it still has to be set here for this app to send mail.
RESEND_API_KEY=
NEWSLETTER_FROM_ADDRESS=
# Signs unsubscribe links: openssl rand -base64 32. Changing it breaks every link already sent.
NEWSLETTER_UNSUBSCRIBE_KEY=

# Personal-data keys: see docs/context/environment-variables.md. Back both up outside the database.
PERSONAL_DATA_ENCRYPTION_KEY=
PERSONAL_DATA_INDEX_KEY=
