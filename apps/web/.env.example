NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SITE_URL=
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
SITE_CONFIG_REVALIDATE_SECRET=
SANITY_GENERATE_SECRET=
ANTHROPIC_API_KEY=
WEB_ANALYTICS_ENABLED=

DATABASE_URL=

# The six vars below are read by @blog/auth (packages/auth/src/utils/env/env.ts),
# not declared in this app's own src/utils/env/env.ts — each app runs its own
# Node process and @blog/auth reads whichever process loaded it, so they still
# have to be set here. Do not delete them just because a grep of apps/web
# turns up no declaration.
# AUTH_SECRET must be byte-identical to apps/admin's AUTH_SECRET, or the two
# apps reject each other's session cookies and shared sign-in fails silently.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
MAGIC_LINK_FROM_ADDRESS=

RESEND_API_KEY=
NEWSLETTER_FROM_ADDRESS=
