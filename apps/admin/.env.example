# Env vars for apps/admin. Next only loads env files from this app's own
# directory, so apps/web/.env.local does NOT reach this app — copy this file
# to apps/admin/.env.local and fill it in even if apps/web is already set up.
#
# The six AUTH_*/MAGIC_LINK_FROM_ADDRESS vars below are declared (with Zod
# validation) in @blog/auth, not in this app's own env module — but this app
# runs its own Node process, and @blog/auth reads whichever process.env
# loaded it. Extracting the shared auth package moved where these are
# *declared*, not where they're *needed*: they still have to be set here.

# Required. Signs/encrypts Auth.js session cookies.
# MUST be byte-identical to apps/web's AUTH_SECRET — the two apps share one
# Auth.js session (see docs/context/environment-variables.md), and a mismatch
# doesn't error, it just makes each app silently reject the other's session
# cookie, so shared sign-in stops working with no visible cause.
AUTH_SECRET=

# Optional OAuth provider credentials — feature-flag-by-absence. Omitting a
# pair disables just that provider's sign-in button; the other methods are
# unaffected.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. "From" address for Auth.js magic-link email. Unset falls back to
# Resend's shared testing sender — fine for local dev.
MAGIC_LINK_FROM_ADDRESS=

# Required. Pooled Neon connection string (drizzle-orm/neon-http), read by
# @blog/db — first consumed here by the Auth.js Drizzle adapter.
DATABASE_URL=

# Optional. Resend API key used to actually send the magic-link email via
# this app's sendEmail (@admin/server/email/send-email). Absent: every other
# sign-in method still works, but magic-link sign-in fails at send time.
RESEND_API_KEY=

# Optional. Read-write token for the Vercel Blob store the Look tab's
# logo/favicon uploads write to. Absent: the upload/clear actions return a
# readable "uploads aren't configured" error instead of failing silently.
BLOB_READ_WRITE_TOKEN=
