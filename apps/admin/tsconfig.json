{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blog/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": {
      "@admin/*": ["./src/*"],
      "@blog/db/*": ["../../packages/db/src/*"],
      "@blog/config/*": ["../../packages/config/src/*"],
      "@blog/ui/*": ["../../packages/ui/src/*"],
      "@blog/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    // @blog/ui's wildcard subpath export ("./*": "./src/*", aliased above)
    // type-checks @blog/ui *source* directly, so its ambient module
    // declarations (e.g. *.svg types) must be in this program too.
    "../../packages/ui/src/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
