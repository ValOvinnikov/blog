# Env vars for apps/worker. Next only loads env files from this app's own
# directory, so copy this file to apps/worker/.env.local and fill it in.
#
# DATABASE_URL and TENANT_TOKEN_ENCRYPTION_KEY are declared in @blog/db, not in
# this app's own env module, but this app runs its own Node process and
# @blog/db reads whichever process.env loaded it: both must be set here.

# Required. Pooled Neon connection string (the registry), read by @blog/db.
DATABASE_URL=

# Required. Encrypts the Sanity tokens @blog/db stores per tenant.
TENANT_TOKEN_ENCRYPTION_KEY=

# Required. Organization-level Sanity token with "create project" permission.
SANITY_MANAGEMENT_TOKEN=

# Required. The Sanity organization every tenant project is created under.
SANITY_ORGANIZATION_ID=

# Required. Vercel API token used to add each tenant's domain to the shared web project.
VERCEL_TOKEN=

# Optional. Only when the Vercel account is team-owned.
VERCEL_TEAM_ID=

# Required. The one shared apps/web Vercel project every tenant's domain is added to.
VERCEL_PROJECT_ID_WEB=

# Required. Base origin of the deployed apps/platform, the Sanity CORS origin each tenant project allows.
PLATFORM_APP_BASE_URL=

# Required. Name of the Sanity dataset created in each tenant project.
TENANT_SANITY_DATASET=

# Required. Base origin of the deployed apps/web; each tenant's revalidation webhook targets it.
WEB_APP_URL=

# Required. Must be byte-identical to apps/web's SANITY_REVALIDATE_SECRET.
SANITY_REVALIDATE_SECRET=

# Required. Shared with apps/platform, which signs every request to this app's routes with it.
WORKER_ENQUEUE_SECRET=

# Required. Shared with apps/platform's /api/internal/operator-alert, which the STALLED owner alert posts to.
OPERATOR_ALERT_SECRET=

# Personal-data keys: see docs/context/environment-variables.md. Back both up outside the database.
PERSONAL_DATA_ENCRYPTION_KEY=
PERSONAL_DATA_INDEX_KEY=
