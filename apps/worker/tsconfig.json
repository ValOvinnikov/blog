{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blog/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@worker/*": ["./src/*"],
      "@blog/db/*": ["../../packages/db/src/*"],
      "@blog/email/*": ["../../packages/email/src/*"],
      "@blog/insight/*": ["../../packages/insight/src/*"],
      "@blog/config/*": ["../../packages/config/src/*"],
      "@blog/utils/*": ["../../packages/utils/src/*"]
    },
    "plugins": [{ "name": "next" }, { "name": "workflow" }]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
