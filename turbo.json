{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/configs/tsconfig/*.json",
        "$TURBO_ROOT$/configs/tailwind/*.ts",
        "$TURBO_ROOT$/configs/tailwind/*.css"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SANITY_DATASET",
        "SANITY_API_READ_TOKEN",
        "SANITY_API_WRITE_TOKEN",
        "NEXT_PUBLIC_SITE_URL",
        "SANITY_REVALIDATE_SECRET",
        "SITE_CONFIG_REVALIDATE_SECRET",
        "ANTHROPIC_API_KEY",
        "SANITY_GENERATE_SECRET",
        "WEB_ANALYTICS_ENABLED",
        "DATABASE_URL",
        "AUTH_SECRET",
        "AUTH_GITHUB_ID",
        "AUTH_GITHUB_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "RESEND_API_KEY",
        "BLOB_READ_WRITE_TOKEN",
        "NEWSLETTER_FROM_ADDRESS",
        "MAGIC_LINK_FROM_ADDRESS",
        "AUTH_COOKIE_DOMAIN",
        "TENANT_TOKEN_ENCRYPTION_KEY",
        "WEB_APP_URL",
        "VERCEL_API_TOKEN",
        "VERCEL_PROJECT_ID_WEB",
        "VERCEL_TEAM_ID",
        "TENANT_PROVISIONING_GITHUB_TOKEN",
        "TENANT_PROVISIONING_GITHUB_REPO",
        "TENANT_PROVISIONING_ADMIN_BASE_URL_OVERRIDE",
        "TENANT_PROVISIONING_DATASET",
        "OPERATOR_ALERT_SECRET",
        "OPERATOR_ALERT_FROM_ADDRESS"
      ],
      "passThroughEnv": ["SKIP_ENV_VALIDATION"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/configs/eslint/*.js"]
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/configs/tsconfig/*.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/configs/vitest/*.ts"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typegen": {
      "cache": false,
      "env": ["SANITY_STUDIO_PROJECT_ID", "SANITY_STUDIO_DATASET"],
      "outputs": [
        "../../packages/config/src/sanity/generated/schema.json",
        "../../packages/config/src/sanity/generated/types.ts"
      ]
    },
    "format": {
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "storybook:build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/configs/tsconfig/*.json",
        "$TURBO_ROOT$/configs/tailwind/*.ts",
        "$TURBO_ROOT$/configs/tailwind/*.css"
      ],
      "outputs": ["storybook-static/**"],
      "passThroughEnv": ["SKIP_ENV_VALIDATION"]
    }
  }
}
