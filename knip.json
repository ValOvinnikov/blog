{
  "$schema": "https://unpkg.com/knip@6.27.0/schema.json",
  // Design specs, an HTML mockup and a reference ThemeToggle — material for
  // humans, in no workspace, never built or imported. Not source, so nothing
  // here can be "unused".
  //
  // .claude/hooks/*.js: invoked as a subprocess by its paired *.sh wrapper
  // (e.g. gate-bypass-guard.sh execs gate-bypass-guard.js), never imported
  // from TS/JS source — invisible to knip's import graph the same way the
  // *.sh hooks already are (knip doesn't scan shell files at all).
  "ignore": ["docs/design-reference/**", ".claude/hooks/*.js"],
  // Root devDependency needed for prettier-plugin-tailwindcss to resolve at
  // runtime for any workspace's Prettier invocation (apps/web is the only
  // config that imports it); nothing in source imports it directly, so
  // knip's root-level import graph can't see the usage.
  "ignoreDependencies": ["prettier-plugin-tailwindcss"],
  "workspaces": {
    "apps/cms": {
      // Each migration's default export is loaded by the Sanity CLI
      // (`sanity migrations run`), never imported from source. Listing them as
      // entries — rather than ignoring them — keeps their own imports analysed.
      // This replaces the default `{index,cli,main}` entry patterns, which match
      // nothing here; the Sanity plugin still contributes sanity.{config,cli}.ts.
      "entry": ["migrations/*/index.ts"]
    },
    "packages/service": {
      // Reachable only through a string in vitest.config.ts's `resolve.alias`,
      // which knip cannot follow. src/index.ts needs no entry of its own — it is
      // already detected from package.json `exports`.
      "entry": ["src/testing/server-only-stub.ts"]
    },
    "packages/db": {
      // Same reason as packages/service above: reachable only through a
      // string in vitest.config.ts's `resolve.alias`.
      "entry": ["src/testing/server-only-stub.ts"]
    },
    "packages/auth": {
      // Same reason as packages/service/packages/db above: reachable only
      // through a string in vitest.config.ts's `resolve.alias`.
      "entry": ["src/testing/server-only-stub.ts"]
    },
    "apps/web": {
      // The test render wrapper (customRender + RTL re-exports) is a testing
      // entry point, consumed by *.test.tsx (adoption lands in #666), not from
      // source. Mark it an entry so its exports aren't reported unused; the
      // Next.js plugin still contributes the app-router entries.
      // (packages/ui needs no such entry: its `./*` package.json export makes
      // the wrapper reachable as public API, so knip already sees it as used.)
      //
      // src/testing/server-only-stub.ts (#1107): same reason as
      // packages/service and packages/db's own entries above — reachable
      // only through a string in vitest.config.ts's `resolve.alias`.
      "entry": [
        "src/testing/custom-render.tsx",
        "src/testing/server-only-stub.ts"
      ],
      // Referenced only as a Turbopack loader string (next.config.ts
      // `turbopack.rules['*.svg'].loaders: ['@svgr/webpack']`) — knip's
      // import graph can't see a bare string naming a package. Strict pnpm
      // (no hoisting) still requires it as a real apps/web devDependency so
      // Turbopack can resolve it.
      //
      // @blog/db dropped from this list (#1107): the Auth.js config
      // (`src/server/auth/auth.ts`) is now the first real
      // `import ... from '@blog/db'` in apps/web.
      "ignoreDependencies": ["@svgr/webpack"]
    },
    "apps/admin": {
      // Referenced only as a Turbopack loader string (next.config.ts
      // `turbopack.rules['*.svg'].loaders: ['@svgr/webpack']`) — knip's
      // import graph can't see a bare string naming a package. Strict pnpm
      // (no hoisting) still requires it as a real apps/admin devDependency so
      // Turbopack can resolve it.
      "ignoreDependencies": ["@svgr/webpack"],
      // next-intl navigation helpers (Link/usePathname), scaffolded to
      // mirror apps/web's i18n/navigation.ts but not yet consumed by any
      // component. Mark it an entry so its exports aren't reported unused;
      // the Next.js plugin still contributes the app-router entries.
      //
      // src/components/shared/{icon,text,button,link-button,status-badge,text-input,alert,heading,textarea,avatar,segmented-control}/index.ts:
      // admin-owned primitives, each built ahead of its call sites as part
      // of a bottom-up migration off @blog/ui. Mark each an entry for the
      // same reason as the navigation helpers above.
      "entry": [
        "src/i18n/navigation.ts",
        "src/components/shared/icon/index.ts",
        "src/components/shared/text/index.ts",
        "src/components/shared/button/index.ts",
        "src/components/shared/link-button/index.ts",
        "src/components/shared/status-badge/index.ts",
        "src/components/shared/text-input/index.ts",
        "src/components/shared/alert/index.ts",
        "src/components/shared/heading/index.ts",
        "src/components/shared/textarea/index.ts",
        "src/components/shared/avatar/index.ts",
        "src/components/shared/segmented-control/index.ts"
      ]
    }
  }
}
