{
  "$schema": "https://unpkg.com/knip@6.27.0/schema.json",
  // Design specs, an HTML mockup and a reference ThemeToggle — material for
  // humans, in no workspace, never built or imported. Not source, so nothing
  // here can be "unused".
  //
  // .claude/hooks/*.js: invoked as a subprocess by its paired *.sh wrapper
  // (e.g. gate-bypass-guard.sh execs gate-bypass-guard.js), never imported
  // from TS/JS source — invisible to knip's import graph the same way the
  // *.sh hooks already are (knip doesn't scan shell files at all).
  "ignore": ["docs/design-reference/**", ".claude/hooks/*.js"],
  // Root devDependency needed for prettier-plugin-tailwindcss to resolve at
  // runtime for any workspace's Prettier invocation (apps/web is the only
  // config that imports it); nothing in source imports it directly, so
  // knip's root-level import graph can't see the usage.
  //
  // jscpd: spawned by path from scripts/check-clones.mjs, which knip cannot
  // trace to the dependency.
  "ignoreDependencies": ["prettier-plugin-tailwindcss", "jscpd"],
  // `sanity` is invoked via `pnpm exec sanity` in
  // `validate-tenant-documents`'s CLI wrapper, resolved from
  // `packages/studio`'s devDependency, not `packages/db`'s own — same
  // cross-workspace resolution gap as `prettier-plugin-tailwindcss` above.
  "ignoreBinaries": ["sanity"],
  "workspaces": {
    "packages/studio": {
      // Only `!`-suffixed patterns are read under `--production`, so restating
      // the default project glob alongside a negated `src/testing/**` drops
      // test infrastructure from the advisory run's reachability graph without
      // touching the required run, where those files are legitimately used.
      // A top-level `ignore` cannot do this: it has no effect on the default
      // graph, so knip raises a config hint and the required check treats
      // hints as errors. Repeated per workspace below, extensions included,
      // because `project` replaces the default rather than extending it. The
      // same negation drops every other file that never ships: migrations,
      // CLI scripts and config, test setup, e2e, Storybook.
      "project": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!",
        "!src/testing/**!",
        "!migrations/**!",
        "!scripts/**!",
        "!sanity-env.ts!"
      ]
    },
    "packages/service": {
      "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!", "!src/testing/**!"]
    },
    "packages/db": {
      // scripts/*.ts, scripts/*/run.ts: package.json `scripts` invokes each
      // via `tsx`, which knip's default mode already reaches — but
      // `--production` ignores the `scripts` field, so mark them production
      // entries (`!`) too, as globs rather than literal paths: a literal
      // path here trips knip's redundant-entry-pattern hint against its own
      // scripts-field auto-detection, a glob doesn't. `scripts/*/run.ts`
      // never collides with a `run.test.ts` sibling; the `*.test.ts` files
      // `scripts/*.ts` also matches stay classified as tests regardless.
      "entry": ["scripts/*.ts!", "scripts/*/run.ts!"],
      "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!", "!src/testing/**!"]
    },
    "apps/web": {
      // The test render wrapper (customRender + RTL re-exports) is a testing
      // entry point, consumed by *.test.tsx (adoption lands in #666), not from
      // source. Mark it an entry so its exports aren't reported unused; the
      // Next.js plugin still contributes the app-router entries.
      // (packages/ui needs no such entry: its `./*` package.json export makes
      // the wrapper reachable as public API, so knip already sees it as used.)
      "entry": ["src/testing/custom-render.tsx"],
      "project": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,mdx,css}!",
        "!src/testing/**!",
        "!src/vitest-setup.ts!",
        "!e2e/**!",
        "!contrast/**!"
      ],
      // Referenced only as a Turbopack loader string (next.config.ts
      // `turbopack.rules['*.svg'].loaders: ['@svgr/webpack']`) — knip's
      // import graph can't see a bare string naming a package. Strict pnpm
      // (no hoisting) still requires it as a real apps/web devDependency so
      // Turbopack can resolve it.
      //
      // @blog/db dropped from this list (#1107): the Auth.js config
      // (`src/server/auth/auth.ts`) is now the first real
      // `import ... from '@blog/db'` in apps/web.
      "ignoreDependencies": ["@svgr/webpack"]
    },
    ".": {
      "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!", "!scripts/**!"]
    },
    "packages/ui": {
      "project": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,mdx,css}!",
        "!.storybook/**!"
      ]
    },
    "packages/insight": {
      "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!", "!src/testing/**!"]
    },
    "apps/platform": {
      "project": [
        "**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,css}!",
        "!src/testing/**!",
        "!src/vitest-setup.ts!"
      ],
      // Referenced only as a Turbopack loader string (next.config.ts
      // `turbopack.rules['*.svg'].loaders: ['@svgr/webpack']`) — knip's
      // import graph can't see a bare string naming a package. Strict pnpm
      // (no hoisting) still requires it as a real apps/platform devDependency so
      // Turbopack can resolve it.
      "ignoreDependencies": ["@svgr/webpack"]
    }
  }
}
