{
  "name": "blog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "node scripts/guard-worktree-install.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "storybook:build": "turbo run storybook:build",
    "typegen": "turbo run typegen",
    "db:studio": "set -a && source apps/web/.env.local && set +a && pnpm --filter @blog/db db:studio",
    "gen:ui-index": "node scripts/gen-ui-index.mjs",
    "gen:ui-index:check": "node scripts/gen-ui-index.mjs --verify",
    "gen:ui-index:test": "node --test scripts/gen-ui-index.test.mjs",
    "check:voice-sync": "node scripts/check-voice-key-sync.mjs",
    "check:voice-sync:test": "node --test scripts/check-voice-key-sync.test.mjs",
    "check:turbo-env-sync": "node scripts/check-turbo-env-sync.mjs",
    "check:turbo-env-sync:test": "node --test scripts/check-turbo-env-sync.test.mjs",
    "check:migration-index": "node scripts/check-migration-index-collision.mjs",
    "check:migration-index:test": "node --test scripts/check-migration-index-collision.test.mjs",
    "check:revalidate-tags-sync": "node scripts/check-revalidate-tags-sync.mjs",
    "check:revalidate-tags-sync:test": "node --test scripts/check-revalidate-tags-sync.test.mjs",
    "check:client-graph": "node scripts/check-client-graph.mjs",
    "check:client-graph:test": "node --test scripts/check-client-graph.test.mjs",
    "check:required-env": "node scripts/check-required-env.mjs",
    "check:required-env:test": "node --test scripts/check-required-env.test.mjs",
    "knip": "knip",
    "format": "turbo run format",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{js,mjs,cjs,json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@blog/prettier-config": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "knip": "6.27.0",
    "lint-staged": "^17.0.8",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.10.5",
    "typescript": "catalog:"
  }
}
