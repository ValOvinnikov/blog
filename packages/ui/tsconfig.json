{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@shinefold/tsconfig/base.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    "paths": {
      "@shinefold/ui/*": ["./src/*"],
      "@shinefold/config/*": ["../../packages/config/src/*"],
      "@shinefold/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src", ".storybook"]
}
