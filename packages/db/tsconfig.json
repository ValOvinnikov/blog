{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blog/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    // Declare ambient globals explicitly so type resolution does not depend on
    // pnpm's hoisting layout: "node" for `process.env`, "vitest/globals" for the
    // `globals: true` test config. Without this, a dependency bump that reshuffles
    // node_modules can drop @types/node discovery and break `tsc`.
    "types": ["node", "vitest/globals"],
    "paths": {
      "@blog/db/*": ["./src/*"],
      "@blog/config/*": ["../../packages/config/src/*"],
      "@blog/insight/*": ["../../packages/insight/src/*"],
      "@blog/email/*": ["../../packages/email/src/*"],
      // Not imported directly by this package's own source — needed only
      // because @blog/email/* resolves to source, and its brand-tokens
      // module imports @blog/utils/color.
      "@blog/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src", "scripts", "drizzle.config.ts"]
}
