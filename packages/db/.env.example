# Pooled Neon connection string, validated by src/utils/env/env.ts and read
# by src/client.ts's getDb(). Needed by anything in this package that runs
# real queries outside a deployed app's own process — e.g.
# `db:seed-admin`/`db:seed-tenant` (scripts/), which call getDb() directly.
# A deployed app (apps/web, apps/admin) provisions this itself; it is not
# scoped to this package alone.
DATABASE_URL=

# Direct (unpooled) Neon connection string, read only by drizzle.config.ts.
# CLI-only — used by `db:generate`/`db:migrate`/`db:studio` (drizzle-kit).
# Never read by a deployed app; a deployed app reads the pooled DATABASE_URL
# above instead.
DATABASE_URL_UNPOOLED=
