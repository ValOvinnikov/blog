{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@shinefold/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@shinefold/auth/*": ["./src/*"],
      "@shinefold/db/*": ["../../packages/db/src/*"],
      "@shinefold/config/*": ["../../packages/config/src/*"],
      "@shinefold/email/*": ["../../packages/email/src/*"],
      "@shinefold/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src"]
}
