{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blog/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    // Explicit so type resolution does not depend on pnpm's hoisting layout.
    "types": ["node", "vitest/globals"],
    "paths": {
      "@blog/email/*": ["./src/*"],
      "@blog/config/*": ["../../packages/config/src/*"],
      "@blog/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src"]
}
