{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@shinefold/tsconfig/base.json",
  "compilerOptions": {
    "paths": {
      "@shinefold/config/*": ["./src/*"],
      "@shinefold/utils/*": ["../utils/src/*"]
    },
    "noEmit": true,
    // "vitest/globals" declares vitest's ambient test globals (vitest config
    // sets `globals: true`) so type resolution does not depend on pnpm's
    // hoisting layout — matches @shinefold/ui, @shinefold/service, and web.
    "types": ["node", "vitest/globals"]
  },
  "include": ["src"]
}
