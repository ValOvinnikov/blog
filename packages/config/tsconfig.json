{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blog/tsconfig/base.json",
  "compilerOptions": {
    "paths": {
      "@blog/config/*": ["./src/*"],
      "@blog/utils/*": ["../utils/src/*"]
    },
    "noEmit": true,
    // "vitest/globals" declares vitest's ambient test globals (vitest config
    // sets `globals: true`) so type resolution does not depend on pnpm's
    // hoisting layout — matches @blog/ui, @blog/service, and web.
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
