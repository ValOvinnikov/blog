{
  "name": "@shinefold/studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "sanity dev --port 3333",
    "typegen": "node scripts/typegen.mjs",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "migrate:list": "sanity migrations list",
    "migrate:new": "node scripts/migrate.mjs new",
    "migrate:track": "node scripts/migrate.mjs track",
    "migrate:current": "node scripts/migrate.mjs current",
    "migrate:dry": "node scripts/migrate.mjs dry",
    "migrate:run": "node scripts/migrate.mjs run",
    "migrate:deploy": "node scripts/migrate.mjs deploy",
    "migrate:backfill": "node scripts/migrate.mjs deploy --backfill",
    "dataset:export": "node scripts/migrate.mjs export",
    "dataset:refresh-dev": "node scripts/refresh-dev-dataset.mjs"
  },
  "dependencies": {
    "@sanity/code-input": "^7.3.16",
    "@sanity/document-internationalization": "^6.3.0",
    "@sanity/language-filter": "^5.0.24",
    "@sanity/orderable-document-list": "^2.0.29",
    "@sanity/ui": "^4.4.12",
    "@sanity/vision": "^6.24.0",
    "@shinefold/config": "workspace:*",
    "@shinefold/utils": "workspace:*",
    "lucide-react": "^1.77.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remeda": "catalog:",
    "sanity": "^6.24.0",
    "sanity-plugin-internationalized-array": "^5.3.10",
    "sanity-plugin-media": "^6.6.3",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@sanity/cli": "^7.7.1",
    "@sanity/client": "^8.17.0",
    "@sanity/validation": "^6.24.0",
    "@shinefold/eslint-config": "workspace:*",
    "@shinefold/prettier-config": "workspace:*",
    "@shinefold/tsconfig": "workspace:*",
    "@shinefold/vitest-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "catalog:",
    "groq-js": "^2.0.3",
    "jsdom": "^29.1.1",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
