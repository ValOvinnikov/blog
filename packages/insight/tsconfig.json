{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@shinefold/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    // Declare ambient globals explicitly so type resolution does not depend on
    // pnpm's hoisting layout: "node" for node:crypto, "vitest/globals" for the
    // `globals: true` test config — matches @shinefold/utils and @shinefold/db.
    "types": ["node", "vitest/globals"],
    "paths": {
      "@shinefold/insight/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
